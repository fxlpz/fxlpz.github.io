---
// Hidden interactive terminal — open with backtick (`) key, close with Esc/exit
---

<div
  id="easter-terminal"
  class="hidden fixed bottom-4 right-4 z-[9999] w-[min(92vw,420px)] h-[320px] bg-[var(--color-gray-darker)] border border-accent/40 rounded-lg shadow-2xl shadow-accent/20 flex flex-col font-mono text-sm overflow-hidden"
>
  <!-- Title bar -->
  <div class="flex items-center justify-between px-3 h-8 bg-[var(--color-gray-medium)] border-b border-[var(--color-gray-medium)] text-xs text-[var(--color-text-muted)]">
    <div class="flex gap-1.5">
      <span class="w-3 h-3 rounded-full bg-danger/70"></span>
      <span class="w-3 h-3 rounded-full bg-warning/70"></span>
      <span class="w-3 h-3 rounded-full bg-success/70"></span>
    </div>
    <span>guest@fxlpz-sec — press ` to toggle</span>
    <button id="easter-close" class="text-[var(--color-text-muted)] hover:text-danger">×</button>
  </div>

  <!-- Output -->
  <div id="easter-output" class="flex-1 overflow-y-auto p-3 text-[var(--color-text-primary)] leading-relaxed">
    <div class="text-accent">[*] secure shell session iniciada</div>
    <div class="text-[var(--color-text-muted)]">digite 'help' para ver os comandos disponíveis</div>
  </div>

  <!-- Input -->
  <div class="flex items-center gap-2 px-3 py-2 border-t border-[var(--color-gray-medium)] bg-[var(--color-gray-dark)]">
    <span class="text-accent">felipe@sec:~$</span>
    <input
      id="easter-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder="digite um comando..."
      class="flex-1 bg-transparent outline-none text-[var(--color-text-primary)] placeholder:text-[var(--color-text-muted)]"
    />
  </div>
</div>

<script>
  // Wire close button
  const term = document.getElementById('easter-terminal');
  const closeBtn = document.getElementById('easter-close');
  closeBtn?.addEventListener('click', () => term?.classList.add('hidden'));
</script>
