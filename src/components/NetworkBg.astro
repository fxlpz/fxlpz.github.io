---
// Interactive Particle Network Background — High performance 2D Canvas.
// Gentle parallax nodes with connection lines that glow on hover.
---

<canvas
	id="network-bg"
	class="fixed inset-0 w-full h-full pointer-events-none z-0 opacity-40 select-none"
	aria-hidden="true"
></canvas>

<script>
(function () {
	const canvas = document.getElementById('network-bg') as HTMLCanvasElement | null;
	if (!canvas) return;

	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
	if (window.matchMedia('(pointer: coarse)').matches) return;

	const ctx = canvas.getContext('2d');
	if (!ctx) return;

	let w = 0, h = 0;
	let mouseX = -1000, mouseY = -1000;
	let animId: number;

	interface Particle {
		x: number;
		y: number;
		vx: number;
		vy: number;
		r: number;
	}

	let particles: Particle[] = [];
	const count = 45;
	const lineDist = 170;

	function resize() {
		w = window.innerWidth;
		h = window.innerHeight;
		canvas!.width = w * devicePixelRatio;
		canvas!.height = h * devicePixelRatio;
		canvas!.style.width = w + 'px';
		canvas!.style.height = h + 'px';
		ctx!.scale(devicePixelRatio, devicePixelRatio);
	}

	function init() {
		particles = [];
		for (let i = 0; i < count; i++) {
			particles.push({
				x: Math.random() * w,
				y: Math.random() * h,
				vx: (Math.random() - 0.5) * 0.25,
				vy: (Math.random() - 0.5) * 0.25,
				r: Math.random() * 1.5 + 1
			});
		}
	}

	function draw() {
		ctx!.clearRect(0, 0, w, h);

		// Draw connections
		for (let i = 0; i < count; i++) {
			const p1 = particles[i];

			// Move
			p1.x += p1.vx;
			p1.y += p1.vy;

			if (p1.x < 0 || p1.x > w) p1.vx *= -1;
			if (p1.y < 0 || p1.y > h) p1.vy *= -1;

			// Mouse effect
			const dx = p1.x - mouseX;
			const dy = p1.y - mouseY;
			const dist = Math.sqrt(dx*dx + dy*dy);
			if (dist < 180) {
				const force = (180 - dist) / 180;
				p1.x += (dx / dist) * force * 1.2;
				p1.y += (dy / dist) * force * 1.2;
			}

			// Draw node
			ctx!.fillStyle = 'rgba(0, 191, 255, 0.45)';
			ctx!.beginPath();
			ctx!.arc(p1.x, p1.y, p1.r, 0, Math.PI * 2);
			ctx!.fill();

			for (let j = i + 1; j < count; j++) {
				const p2 = particles[j];
				const lx = p1.x - p2.x;
				const ly = p1.y - p2.y;
				const ld = Math.sqrt(lx*lx + ly*ly);

				if (ld < lineDist) {
					const alpha = (1 - ld / lineDist) * 0.12;
					ctx!.strokeStyle = `rgba(0, 191, 255, ${alpha})`;
					ctx!.lineWidth = 0.75;
					ctx!.beginPath();
					ctx!.moveTo(p1.x, p1.y);
					ctx!.lineTo(p2.x, p2.y);
					ctx!.stroke();
				}
			}
		}

		animId = requestAnimationFrame(draw);
	}

	window.addEventListener('mousemove', (e) => {
		mouseX = e.clientX;
		mouseY = e.clientY;
	});

	window.addEventListener('mouseleave', () => {
		mouseX = -1000;
		mouseY = -1000;
	});

	window.addEventListener('resize', () => {
		resize();
		init();
	});

	resize();
	init();
	draw();
})();
</script>
