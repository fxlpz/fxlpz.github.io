---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const isActive = href === pathname || href === '/' + pathname.split('/')[1];
---

<a
	href={href}
	class:list={[
		className,
		'relative px-3 py-2 text-sm font-mono rounded-md text-[var(--color-text-dim)] hover:text-[var(--color-accent)] transition-all',
		isActive ? 'text-[var(--color-accent)]' : '',
	]}
	{...props}
>
	<slot />
	{isActive && (
		<span class="absolute inset-x-2 bottom-1 h-px bg-[var(--color-accent)] rounded-full"></span>
	)}
</a>
