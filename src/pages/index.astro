---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import avatarImg from '../assets/avatar.png';
import { AUTHOR_NAME } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout>
	<div class="space-y-20 py-8">
		<!-- Hero Section -->
		<section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center min-h-[60vh]">
			<!-- Info Left -->
			<div class="lg:col-span-7 space-y-6">
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-accent-glow)] border border-[var(--color-accent)]/20 text-xs font-mono text-[var(--color-accent)]">
					<span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-ping"></span>
					Active Recon & Vulnerability Hunting
				</div>

				<div class="space-y-3">
					<div class="font-mono text-[var(--color-text-mute)] text-sm">┌─[felipe@sec-analyst]</div>
					<h1 class="text-4xl sm:text-6xl font-mono font-bold tracking-tight text-[var(--color-text)]">
						{AUTHOR_NAME}
					</h1>
					<div class="font-mono text-[var(--color-text-dim)] text-base sm:text-lg flex flex-wrap items-center gap-2">
						<span>└─$ ./run</span>
						<span class="text-[var(--color-accent)] font-semibold" id="typed-text">"OffSec // Pentest Web // Bug Bounty"</span>
					</div>
				</div>

				<p class="text-base sm:text-lg text-[var(--color-text-dim)] leading-relaxed max-w-xl">
					Especialista em segurança ofensiva focado em Pentesting Web, recon avançado e quebra de controles de acesso. Com background de programador Full Stack para auditar código e explorar vulnerabilidades lógicas.
				</p>

				<div class="flex flex-wrap gap-4 font-mono text-xs">
					<a href="/sobre" class="px-5 py-3 bg-[var(--color-accent)] text-[var(--color-bg)] font-bold rounded-lg border border-[var(--color-accent)] hover:bg-transparent hover:text-[var(--color-accent)] transition-all shadow-lg shadow-accent/20">
						./sobre_mim.sh
					</a>
					<a href="/contato" class="px-5 py-3 bg-[var(--color-panel)] text-[var(--color-text)] border border-[var(--color-line)] rounded-lg hover:border-[var(--color-accent)]/40 hover:text-[var(--color-accent)] transition-all">
						cat contact.json
					</a>
				</div>
			</div>

			<!-- Image Right -->
			<div class="lg:col-span-5 flex justify-center">
				<div class="relative w-64 h-64 sm:w-72 sm:h-72 group">
					<div class="absolute -inset-1.5 bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-dark)] rounded-xl opacity-20 blur group-hover:opacity-40 transition duration-500"></div>

					<!-- Visual Terminal Frame -->
					<div class="relative w-full h-full term-frame flex flex-col">
						<div class="term-bar">
							<span class="term-dot term-dot-red"></span>
							<span class="term-dot term-dot-yellow"></span>
							<span class="term-dot term-dot-green"></span>
							<span class="term-title">target_avatar.png</span>
						</div>
						<div class="flex-grow flex items-center justify-center p-6 bg-gradient-to-b from-[var(--color-panel)] to-[var(--color-panel-2)] relative">
							<div class="absolute inset-0 bg-repeat bg-[linear-gradient(rgba(0,191,255,0.015)_1px,transparent_1px)] bg-[size:100%_4px] pointer-events-none z-20"></div>
							<Image
								src={avatarImg}
								alt="Felipe da Silva Rosa"
								width={240}
								height={240}
								class="rounded-lg object-cover grayscale brightness-90 contrast-125 border border-[var(--color-line)] group-hover:border-[var(--color-accent)]/30 group-hover:scale-[1.02] transition duration-500"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Highlighted Stats -->
		<section class="grid grid-cols-1 md:grid-cols-3 gap-6 font-mono text-center reveal">
			<div class="p-6 rounded-lg bg-[var(--color-panel)] border border-[var(--color-line)] hover:border-[var(--color-line-hover)] transition-all">
				<div class="text-3xl font-bold text-[var(--color-accent)] mb-1">-63%</div>
				<div class="text-[10px] text-[var(--color-text-mute)] uppercase tracking-wider">Tempo Médio de Atendimento (TMA)</div>
			</div>
			<div class="p-6 rounded-lg bg-[var(--color-panel)] border border-[var(--color-line)] hover:border-[var(--color-line-hover)] transition-all">
				<div class="text-3xl font-bold text-[var(--color-accent)] mb-1">40%</div>
				<div class="text-[10px] text-[var(--color-text-mute)] uppercase tracking-wider">Processos Automatizados via Python</div>
			</div>
			<div class="p-6 rounded-lg bg-[var(--color-panel)] border border-[var(--color-line)] hover:border-[var(--color-line-hover)] transition-all">
				<div class="text-3xl font-bold text-[var(--color-accent)] mb-1">Active</div>
				<div class="text-[10px] text-[var(--color-text-mute)] uppercase tracking-wider">HackerOne Bug Bounty Program</div>
			</div>
		</section>

		<!-- Quick Blog Highlight -->
		<section class="space-y-6">
			<div class="flex items-center justify-between border-b border-[var(--color-line)] pb-4 reveal">
				<h2 class="text-xl font-mono font-bold tracking-tight text-[var(--color-text)] m-0">
					&gt; Recentes_Writeups
				</h2>
				<a href="/blog" class="font-mono text-xs text-[var(--color-text-dim)] hover:text-[var(--color-accent)]">
					ver todos &rarr;
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{posts.map((post) => (
					<article class="p-6 rounded-xl bg-[var(--color-panel)] border border-[var(--color-line)] hover:border-[var(--color-accent)]/30 transition-all flex flex-col justify-between group tilt">
						<div class="space-y-4">
							<div class="flex items-center justify-between text-xs font-mono text-[var(--color-text-mute)]">
								<span>{post.data.pubDate.toLocaleDateString('pt-BR')}</span>
								<span class="px-2.5 py-0.5 rounded bg-[var(--color-panel-2)] text-[var(--color-accent)] border border-[var(--color-line)]">
									{post.data.category}
								</span>
							</div>
							<h3 class="text-lg font-bold group-hover:text-[var(--color-accent)] transition-colors leading-snug font-mono">
								<a href={`/blog/${post.id}/`} class="text-inherit hover:text-inherit border-none">{post.data.title}</a>
							</h3>
							<p class="text-sm text-[var(--color-text-dim)] line-clamp-2 leading-relaxed">
								{post.data.description}
							</p>
						</div>
						<div class="mt-6 flex justify-between items-center text-xs font-mono">
							<div class="flex gap-2">
								{post.data.tags.slice(0, 2).map(tag => (
									<span class="text-[var(--color-text-mute)]">#{tag}</span>
								))}
							</div>
							<span class="text-[var(--color-accent)] flex items-center gap-1.5 group-hover:translate-x-1 transition-transform">
								read --more &rarr;
							</span>
						</div>
					</article>
				))}
			</div>
		</section>
	</div>
</BaseLayout>
