							<span class="text-[var(--color-text-muted)]">EMAIL:</span>
							<a href="mailto:felipe.rosa.secdev@gmail.com" class="text-accent hover:underline">felipe.rosa.secdev@gmail.com</a>
						</div>
						<div class="flex items-center justify-between py-1 border-b border-[var(--color-gray-medium)]">
							<span class="text-[var(--color-text-muted)]">LOCALIZAÇÃO:</span>
							<span class="text-[var(--color-text-primary)]">Jundiaí, SP, Brasil</span>
						</div>
						<div class="flex items-center justify-between py-1">
							<span class="text-[var(--color-text-muted)]">DISPONIBILIDADE:</span>
							<span class="text-success font-semibold flex items-center gap-1.5">
								<span class="w-2.5 h-2.5 rounded-full bg-success animate-ping"></span>
								Active / Open to Work
							</span>
						</div>
					</div>

					<div class="flex flex-wrap gap-4 font-mono text-sm">
						<a href="mailto:felipe.rosa.secdev@gmail.com" class="px-6 py-3 bg-accent text-[var(--color-gray-darker)] font-bold rounded-lg hover:bg-accent/80 transition-all shadow-md shadow-accent/10">
							email --send "felipe"
						</a>
						<a href="https://www.linkedin.com/in/felipe0x01/" target="_blank" rel="noopener noreferrer" class="px-6 py-3 border border-[var(--color-gray-medium)] rounded-lg hover:border-accent hover:text-accent transition-all">
							./linkedin_connect
						</a>
					</div>
				</div>
			</div>
		</section>

		<Footer />
		<Effects />
			<HiddenTerminal />
		</body>
