---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR_NAME } from '../consts';
import avatarImg from '../assets/avatar.png';
import HeroCanvas from '../components/HeroCanvas.astro';
import Effects from '../components/Effects.astro';
import HiddenTerminal from '../components/HiddenTerminal.astro';
import AsciiSeparator from '../components/AsciiSeparator.astro';

// Get latest 3 blog posts
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
	<head>
		<!--
   ______   _  _____ _     ______ ____________
  |  ___| | |/  ___| |    | ___ \___  /___  /
  | |_    | |\ `--.| |    | |_/ /  / /   / /
  |  _|   | | `--. \ |    |  __/  / /   / /
  | |     | |/\__/ / |____| |   ./ /___/ /___
  \_|     \_/\____/\_____/\_|   \_____/\____/

  [!] Looking under the hood? Nice recon work.
  [!] Contact me: felipe.rosa.secdev@gmail.com
  [!] Press ` (backtick) anytime to open the interactive shell.
		-->
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex flex-col min-h-screen text-[var(--color-text-primary)] bg-[var(--color-gray-dark)] selection:bg-accent selection:text-gray-darker">
		<Header />

		<!-- Hero Section -->
		<section class="relative min-h-[90vh] flex items-center justify-center py-16 overflow-hidden border-b border-[var(--color-gray-medium)]">
			<!-- Background cyber grids -->
			<div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(0,191,255,0.15),rgba(255,255,255,0))]"></div>
				<HeroCanvas />
			<div class="absolute inset-y-0 right-0 w-1/2 bg-[linear-gradient(to_right,transparent_95%,rgba(0,191,255,0.05))] [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>

			<div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
				<!-- Hero Left: Prompt & Headings -->
				<div class="lg:col-span-7 flex flex-col space-y-6">
					<!-- Prompts -->
					<div class="font-mono text-sm inline-flex items-center gap-2 bg-[var(--color-gray-medium)] text-accent px-3 py-1.5 rounded-md self-start border border-accent/20">
						<span class="animate-pulse">●</span> Ready: fxlpz.sec.active
					</div>

					<div class="space-y-2">
						<div class="font-mono text-[var(--color-text-muted)] text-lg">┌─[felipe@security-analyst]</div>
						<h1 class="text-4xl sm:text-6xl font-mono font-bold tracking-tight text-[var(--color-text-primary)]">
							{AUTHOR_NAME}
						</h1>
						<div class="font-mono text-[var(--color-text-muted)] text-lg flex flex-wrap items-center gap-2">
							<span>└─$ ./run</span>
							<span class="text-accent font-semibold" id="typed-text">"OffSec / Pentest / Bug Bounty"</span>
						</div>
					</div>

					<p class="text-lg sm:text-xl text-[var(--color-text-muted)] leading-relaxed max-w-xl">
						Especialista em segurança ofensiva focado em Pentesting Web, recon avançado e quebra de controles de acesso. Com background de programador Full Stack para auditar código e explorar vulnerabilidades lógicas.
					</p>

					<!-- Buttons CTAs -->
					<div class="flex flex-wrap gap-4 pt-4 font-mono text-sm">
						<a href="/blog" class="px-6 py-3 bg-accent text-[var(--color-gray-darker)] font-semibold rounded-lg border border-accent hover:bg-transparent hover:text-accent transition-all flex items-center gap-2 shadow-lg shadow-accent/20">
							<span>$ cat blog/</span>
							<span>&rarr;</span>
						</a>
						<a href="#contato" class="px-6 py-3 bg-transparent text-[var(--color-text-primary)] font-semibold rounded-lg border border-[var(--color-gray-medium)] hover:border-accent hover:text-accent transition-all">
							./contato.sh
						</a>
					</div>
				</div>

				<!-- Hero Right: Stylized Avatar Frame -->
				<div class="lg:col-span-5 flex justify-center items-center">
					<div class="relative w-72 h-72 sm:w-80 sm:h-80 group">
						<!-- Scanner line animation -->
						<div class="absolute -inset-1.5 bg-gradient-to-r from-accent to-accent-dark rounded-xl blur opacity-30 group-hover:opacity-60 transition duration-1000 group-hover:duration-200"></div>

						<!-- Interactive Terminal style window -->
						<div class="relative w-full h-full bg-[var(--color-gray-darker)] rounded-xl border border-[var(--color-gray-medium)] overflow-hidden flex flex-col">
							<!-- Header of window -->
							<div class="h-8 bg-[var(--color-gray-medium)] border-b border-[var(--color-gray-medium)] flex items-center justify-between px-4 font-mono text-xs text-[var(--color-text-muted)]">
								<div class="flex gap-1.5">
									<span class="w-3 h-3 rounded-full bg-danger/70"></span>
									<span class="w-3 h-3 rounded-full bg-warning/70"></span>
									<span class="w-3 h-3 rounded-full bg-success/70"></span>
								</div>
								<span>target_profile.jpg</span>
								<span></span>
							</div>

							<!-- Image content -->
							<div class="flex-grow relative flex items-center justify-center p-6 bg-radial from-accent/5 to-transparent">
								<!-- Scanner overlay line -->
								<div class="absolute left-0 top-0 w-full h-0.5 bg-accent/50 animate-[bounce_4s_infinite] shadow-neon z-20"></div>
								<Image
									src={avatarImg}
									alt="Felipe da Silva Rosa - Avatar"
									width={280}
									height={280}
									class="relative rounded-lg max-w-full max-h-full object-cover grayscale contrast-125 mix-blend-screen opacity-90 border border-accent/20"
								/>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<AsciiSeparator />

		<!-- Sobre Section -->
		<section id="sobre" class="py-24 border-b border-[var(--color-gray-medium)] relative">
			<div class="max-w-6xl mx-auto px-4 sm:px-6">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
					<!-- Title -->
					<div class="lg:col-span-4 space-y-4 reveal">
						<div class="font-mono text-accent text-sm tracking-wider uppercase">// 01. QUEM SOU EU</div>
						<h2 class="text-3xl font-mono font-bold text-[var(--color-text-primary)]">
							&gt; A_Vantagem_Dev
						</h2>
						<div class="w-20 h-1 bg-accent rounded"></div>
					</div>

					<!-- Content -->
					<div class="lg:col-span-8 space-y-6 text-lg text-[var(--color-text-muted)] leading-relaxed">
						<p>
							Minha jornada em segurança ofensiva é alicerçada em uma base robusta de **3+ anos como desenvolvedor Full Stack (Java/React)** e suporte técnico. Esse background de quem já construiu sistemas me dá uma capacidade analítica diferenciada: eu não apenas rodo scanners automáticos, mas analiso o fluxo lógico do código, entendo regras de autenticação e identifico caminhos de exploração que ferramentas comuns ignoram.
						</p>
						<p>
							Sou recém-formado em **Segurança da Informação pela PUC Minas** e estou atualmente no processo de obtenção da certificação **DCPT (Desec Certified Penetration Tester)** da Desec Security, uma das referências mais práticas do mercado brasileiro. Atuo de forma ativa na **HackerOne**, buscando vulnerabilidades críticas em programas reais e gerando reports técnicos detalhados e PoCs limpos.
						</p>

						<!-- Key Stats Grid -->
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 font-mono text-center">
							<div class="p-6 rounded-lg bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)]">
								<div class="text-3xl font-bold text-accent mb-1">-63%</div>
								<div class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">Tempo Médio de Atendimento (TMA)</div>
							</div>
							<div class="p-6 rounded-lg bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)]">
								<div class="text-3xl font-bold text-accent mb-1">40%</div>
								<div class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">Processos Automatizados via Python</div>
							</div>
							<div class="p-6 rounded-lg bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)]">
								<div class="text-3xl font-bold text-accent mb-1">Active</div>
								<div class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">HackerOne Bug Bounty Program</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Bug Bounty & CTFs Section -->
		<section id="hacker-profiles" class="py-24 border-b border-[var(--color-gray-medium)] bg-[var(--color-gray-darker)]/40">
			<div class="max-w-6xl mx-auto px-4 sm:px-6">
				<div class="text-center max-w-2xl mx-auto mb-16 space-y-4 reveal">
					<div class="font-mono text-accent text-sm tracking-wider uppercase">// 02. PROVAS DE CONCEITO</div>
					<h2 class="text-3xl font-mono font-bold text-[var(--color-text-primary)]">
						Plataformas de Recon & Atuação
					</h2>
					<p class="text-[var(--color-text-muted)]">
						Minha atuação prática no ecossistema de cibersegurança global, do laboratório simulado à caça real a falhas.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<!-- HackerOne -->
					<div class="p-8 rounded-xl bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)] hover:border-accent/40 transition-all flex flex-col justify-between group tilt-card">
						<div>
							<div class="flex items-center justify-between mb-6">
								<div class="font-mono font-bold text-accent">H1 / BUG BOUNTY</div>
								<span class="w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center font-mono text-xs font-bold">BB</span>
							</div>
							<h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition-colors">HackerOne Profile</h3>
							<p class="text-sm text-[var(--color-text-muted)] mb-6 leading-relaxed">
								Pesquisa de vulnerabilidades ativas em programas privados e públicos. Foco em falhas de OWASP Top 10 como SSRF, IDOR, Broken Authentication/ACL e JWT Bypass.
							</p>
						</div>
						<a href="https://hackerone.com" target="_blank" rel="noopener noreferrer" class="font-mono text-sm flex items-center gap-2 group-hover:gap-3 transition-all text-accent">
							<span>./view_reports.sh</span>
							<span>&rarr;</span>
						</a>
					</div>

					<!-- TryHackMe -->
					<div class="p-8 rounded-xl bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)] hover:border-accent/40 transition-all flex flex-col justify-between group tilt-card">
						<div>
							<div class="flex items-center justify-between mb-6">
								<div class="font-mono font-bold text-accent">THM / LABS</div>
								<span class="w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center font-mono text-xs font-bold">CTF</span>
							</div>
							<h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition-colors">TryHackMe Room Solves</h3>
							<p class="text-sm text-[var(--color-text-muted)] mb-6 leading-relaxed">
								Foco em escalonamento de privilégios Linux/Windows, técnicas de Pivoting, Active Directory exploitation, e recon estruturado de serviços e portas expostas.
							</p>
						</div>
						<a href="https://tryhackme.com/p/Fxplz" target="_blank" rel="noopener noreferrer" class="font-mono text-sm flex items-center gap-2 group-hover:gap-3 transition-all text-accent">
							<span>./inspect_thm.sh</span>
							<span>&rarr;</span>
						</a>
					</div>

					<!-- HackTheBox -->
					<div class="p-8 rounded-xl bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)] hover:border-accent/40 transition-all flex flex-col justify-between group tilt-card">
						<div>
							<div class="flex items-center justify-between mb-6">
								<div class="font-mono font-bold text-accent">HTB / HARDENING</div>
								<span class="w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center font-mono text-xs font-bold">BOX</span>
							</div>
							<h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition-colors">HackTheBox Machines</h3>
							<p class="text-sm text-[var(--color-text-muted)] mb-6 leading-relaxed">
								Resolução de máquinas Linux e Windows com dificuldade variada. Criação de rotinas próprias de pós-exploração e escrita de write-ups metodológicos.
							</p>
						</div>
						<a href="https://app.hackthebox.com/users/2483868" target="_blank" rel="noopener noreferrer" class="font-mono text-sm flex items-center gap-2 group-hover:gap-3 transition-all text-accent">
							<span>./access_htb.sh</span>
							<span>&rarr;</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Skills Section -->
		<section id="skills" class="py-24 border-b border-[var(--color-gray-medium)]">
			<div class="max-w-6xl mx-auto px-4 sm:px-6">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
					<!-- Title -->
					<div class="lg:col-span-4 space-y-4 reveal">
						<div class="font-mono text-accent text-sm tracking-wider uppercase">// 03. HABILIDADES</div>
						<h2 class="text-3xl font-mono font-bold text-[var(--color-text-primary)]">
							&gt; Stack_&amp;_Tools
						</h2>
						<p class="text-[var(--color-text-muted)] text-sm">
							Minhas ferramentas de cabeceira divididas por categoria de especialidade técnica.
						</p>
						<div class="w-20 h-1 bg-accent rounded"></div>
					</div>

					<!-- Skills lists -->
					<div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-8">
						<!-- Segurança Ofensiva -->
						<div class="p-6 rounded-lg bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)]">
							<h3 class="font-mono text-accent text-lg font-bold mb-4 flex items-center gap-2">
								<span>#</span> Segurança Ofensiva
							</h3>
							<ul class="space-y-2 text-sm text-[var(--color-text-muted)] font-mono">
								<li class="flex items-center gap-2"><span class="text-accent">&gt;</span> Pentest Web (OWASP Top 10)</li>
								<li class="flex items-center gap-2"><span class="text-accent">&gt;</span> Recon Avançado &amp; OSINT</li>
								<li class="flex items-center gap-2"><span class="text-accent">&gt;</span> Análise de JWT &amp; API Testing</li>
								<li class="flex items-center gap-2"><span class="text-accent">&gt;</span> Escalonamento de Privilégio</li>
								<li class="flex items-center gap-2"><span class="text-accent">&gt;</span> Google Hacking p/ OffSec</li>
							</ul>
						</div>

						<!-- Ferramentas de Teste -->
						<div class="p-6 rounded-lg bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)]">
							<h3 class="font-mono text-accent text-lg font-bold mb-4 flex items-center gap-2">
								<span>#</span> Arsenal Ofensivo
							</h3>
							<div class="flex flex-wrap gap-2">
								{['Kali Linux', 'Burp Suite', 'Nmap', 'Ffuf', 'Subfinder', 'Amass', 'SQLMap', 'Metasploit', 'Wireshark'].map(tool => (
									<span class="px-2.5 py-1 rounded bg-[var(--color-gray-medium)] border border-[var(--color-gray-medium)] text-xs text-[var(--color-text-primary)] font-mono">
										{tool}
									</span>
								))}
							</div>
						</div>

						<!-- Linguagens -->
						<div class="p-6 rounded-lg bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)]">
							<h3 class="font-mono text-accent text-lg font-bold mb-4 flex items-center gap-2">
								<span>#</span> Linguagens &amp; Scripts
							</h3>
							<div class="flex flex-wrap gap-2">
								{['Python (Exploits/Automation)', 'GoLang', 'Java (Spring Boot)', 'React.js', 'Shell Script', 'SQL'].map(lang => (
									<span class="px-2.5 py-1 rounded bg-[var(--color-gray-medium)] border border-[var(--color-gray-medium)] text-xs text-[var(--color-text-primary)] font-mono">
										{lang}
									</span>
								))}
							</div>
						</div>

						<!-- Infraestrutura -->
						<div class="p-6 rounded-lg bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)]">
							<h3 class="font-mono text-accent text-lg font-bold mb-4 flex items-center gap-2">
								<span>#</span> Infra &amp; Redes
							</h3>
							<ul class="space-y-2 text-sm text-[var(--color-text-muted)] font-mono">
								<li class="flex items-center gap-2"><span class="text-accent">&gt;</span> Debian / Arch / RHEL</li>
								<li class="flex items-center gap-2"><span class="text-accent">&gt;</span> Windows Server / Active Directory</li>
								<li class="flex items-center gap-2"><span class="text-accent">&gt;</span> Docker / Containers</li>
								<li class="flex items-center gap-2"><span class="text-accent">&gt;</span> TCP/IP &amp; Firewall Check Point</li>
								<li class="flex items-center gap-2"><span class="text-accent">&gt;</span> Fundamentos Cisco &amp; Roteamento</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Experiência Timeline -->
		<section id="experiencia" class="py-24 border-b border-[var(--color-gray-medium)] bg-[var(--color-gray-darker)]/40">
			<div class="max-w-6xl mx-auto px-4 sm:px-6">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
					<!-- Title -->
					<div class="lg:col-span-4 space-y-4 reveal">
						<div class="font-mono text-accent text-sm tracking-wider uppercase">// 04. EXPERIÊNCIA</div>
						<h2 class="text-3xl font-mono font-bold text-[var(--color-text-primary)]">
							&gt; Histórico_Profissional
						</h2>
						<div class="w-20 h-1 bg-accent rounded"></div>
					</div>

					<!-- Timeline -->
					<div class="lg:col-span-8 relative border-l border-[var(--color-gray-medium)] pl-6 space-y-12 font-mono">
						<!-- SAM -->
						<div class="relative">
							<!-- Timeline point -->
							<div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-[var(--color-gray-dark)] border-2 border-accent"></div>
							<div class="space-y-2">
								<div class="flex items-center justify-between flex-wrap gap-2 text-xs">
									<span class="text-accent font-semibold">SAM (Sistema de Atendimento Médico)</span>
									<span class="text-[var(--color-text-muted)]">jan/2023 – jan/2024</span>
								</div>
								<h3 class="text-xl font-bold text-[var(--color-text-primary)]">Dev Full Stack</h3>
								<p class="text-sm text-[var(--color-text-muted)] leading-relaxed font-sans">
									Desenvolvimento de APIs REST robustas em Java/Spring Boot e interfaces modernas em React. Foco contínuo em validação estrita de entrada, sanitização e mitigação de vulnerabilidades lógicas. Implementei automação em Python que reduziu em 40% o tempo gasto com processos operacionais manuais. Administração de servidores locais Linux e Windows Server.
								</p>
							</div>
						</div>

						<!-- Mitutoyo -->
						<div class="relative">
							<div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-[var(--color-gray-dark)] border-2 border-accent"></div>
							<div class="space-y-2">
								<div class="flex items-center justify-between flex-wrap gap-2 text-xs">
									<span class="text-accent font-semibold">Mitutoyo Sul Americana</span>
									<span class="text-[var(--color-text-muted)]">mar/2025 – mar/2026</span>
								</div>
								<h3 class="text-xl font-bold text-[var(--color-text-primary)]">Estagiário de Suporte de Informática</h3>
								<p class="text-sm text-[var(--color-text-muted)] leading-relaxed font-sans">
									Suporte completo N1/N2 para mais de 50 usuários em ambientes Microsoft e Linux. Desenvolvi documentações técnicas de procedimentos que geraram uma redução direta de 63% no TMA (Tempo Médio de Atendimento). Responsável pela auditoria interna e gestão de ativos de informática, bem como migrações e atualizações de infraestrutura.
								</p>
							</div>
						</div>

						<!-- FUMAS -->
						<div class="relative">
							<div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-[var(--color-gray-dark)] border-2 border-accent"></div>
							<div class="space-y-2">
								<div class="flex items-center justify-between flex-wrap gap-2 text-xs">
									<span class="text-accent font-semibold">FUMAS</span>
									<span class="text-[var(--color-text-muted)]">fev/2024 – mar/2025</span>
								</div>
								<h3 class="text-xl font-bold text-[var(--color-text-primary)]">Estagiário de Suporte</h3>
								<p class="text-sm text-[var(--color-text-muted)] leading-relaxed font-sans">
									Suporte de sistemas para equipes internas de atendimento. Configuração e troubleshooting em redes locais TCP/IP, switches, ambientes operacionais Windows Client e ferramentas de produtividade.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Certificações e Formação -->
		<section class="py-24 border-b border-[var(--color-gray-medium)]">
			<div class="max-w-6xl mx-auto px-4 sm:px-6">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
					<!-- Title -->
					<div class="lg:col-span-4 space-y-4 reveal">
						<div class="font-mono text-accent text-sm tracking-wider uppercase">// 05. FORMAÇÃO & CERTIFICAÇÕES</div>
						<h2 class="text-3xl font-mono font-bold text-[var(--color-text-primary)]">
							&gt; Certificacoes
						</h2>
						<div class="w-20 h-1 bg-accent rounded"></div>
					</div>

					<!-- Content lists -->
					<div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-8 font-mono">
