								</div>
								<h3 class="text-xl font-bold mb-3 group-hover:text-accent transition-colors line-clamp-2 leading-snug">
									<a href={`/blog/${post.id}/`} class="text-inherit hover:text-inherit border-none">{post.data.title}</a>
								</h3>
								<p class="text-sm text-[var(--color-text-muted)] line-clamp-3 mb-6 font-sans leading-relaxed">
									{post.data.description}
								</p>
							</div>
							<a href={`/blog/${post.id}/`} class="font-mono text-xs text-accent flex items-center gap-1.5">
								<span>$ read --more</span>
								<span>&rarr;</span>
							</a>
						</article>
					))}
