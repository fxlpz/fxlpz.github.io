					<div class="space-y-4">
						<div class="font-mono text-accent text-sm tracking-wider uppercase">// 06. ÚLTIMOS WRITE-UPS</div>
						<h2 class="text-3xl font-mono font-bold text-[var(--color-text-primary)]">
							&gt; Publicacoes_Recentes
						</h2>
					</div>
					<a href="/blog" class="font-mono text-sm px-4 py-2 border border-[var(--color-gray-medium)] rounded-lg hover:border-accent hover:text-accent transition-all">
						./ver_todos_posts.sh
					</a>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{posts.map((post) => (
						<article class="p-6 rounded-xl bg-[var(--color-gray-darker)] border border-[var(--color-gray-medium)] hover:border-accent/40 transition-all flex flex-col justify-between group tilt-card">
