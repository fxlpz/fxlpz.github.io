---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contato">
	<div class="max-w-3xl mx-auto space-y-12 py-6">
		<!-- Section Header -->
		<div class="space-y-3 reveal text-center">
			<span class="page-eyebrow">// 04. CONNECTION</span>
			<h1 class="text-3xl sm:text-4xl font-mono font-bold text-[var(--color-text)]">
				&gt; Iniciar_Handshake
			</h1>
			<div class="w-16 h-0.5 bg-[var(--color-accent)] mx-auto"></div>
		</div>

		<!-- Main Card -->
		<div class="p-8 sm:p-10 rounded-xl bg-[var(--color-panel)] border border-[var(--color-line)] shadow-2xl shadow-black/80 flex flex-col items-center text-center space-y-8 reveal">
			<p class="max-w-md text-[var(--color-text-dim)] text-sm sm:text-base leading-relaxed">
				Fique à vontade para propor auditorias de segurança ofensiva, consultorias de pentest, parcerias de pesquisa ou discutir bugs de segurança.
			</p>

			<!-- Connection status block -->
			<div class="w-full max-w-md bg-[var(--color-panel-2)] rounded-lg p-5 border border-[var(--color-line)] font-mono text-xs text-left space-y-3">
				<div class="flex items-center justify-between py-1 border-b border-[var(--color-line-soft)]">
					<span class="text-[var(--color-text-mute)]">CANAL DIRECT:</span>
					<a href="mailto:felipe.rosa.secdev@gmail.com" class="text-[var(--color-accent)] hover:underline">felipe.rosa.secdev@gmail.com</a>
				</div>
				<div class="flex items-center justify-between py-1 border-b border-[var(--color-line-soft)]">
					<span class="text-[var(--color-text-mute)]">LOCALIZAÇÃO:</span>
					<span class="text-[var(--color-text)]">Jundiaí, SP, Brasil</span>
				</div>
				<div class="flex items-center justify-between py-1">
					<span class="text-[var(--color-text-mute)]">STATUS:</span>
					<span class="text-[var(--color-success)] font-semibold flex items-center gap-1.5">
						<span class="w-2 h-2 rounded-full bg-[var(--color-success)] animate-ping"></span>
						Active / Open to Work
					</span>
				</div>
			</div>

			<!-- Direct connection triggers -->
			<div class="flex flex-wrap gap-4 font-mono text-xs justify-center w-full">
				<a href="mailto:felipe.rosa.secdev@gmail.com" class="px-5 py-3 bg-[var(--color-accent)] text-[var(--color-bg)] font-bold rounded-lg hover:bg-transparent hover:text-[var(--color-accent)] border border-[var(--color-accent)] transition-all shadow-md shadow-accent/10">
					email --send "felipe"
				</a>
				<a href="https://www.linkedin.com/in/felipe0x01/" target="_blank" rel="noopener noreferrer" class="px-5 py-3 border border-[var(--color-line)] rounded-lg hover:border-[var(--color-accent)]/40 hover:text-[var(--color-accent)] transition-all">
					./linkedin_connect.sh
				</a>
			</div>
		</div>
	</div>
</BaseLayout>
