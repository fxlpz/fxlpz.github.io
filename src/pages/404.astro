---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`404 | ${SITE_TITLE}`}>
	<div class="min-h-[60vh] flex items-center justify-center">
		<div class="text-center font-mono space-y-6">
			<div class="text-6xl sm:text-8xl font-bold text-[var(--color-accent)] glow-text">404</div>
			<div class="text-lg text-[var(--color-text-dim)]">$ connection refused: route not found</div>
			<div class="text-sm text-[var(--color-text-mute)] pt-2">
				<span class="text-[var(--color-accent)]">┌─[guest@sec]</span><br />
				<span>└─$ ./retry --redirect=home</span>
			</div>
			<a
				href="/"
				class="inline-block mt-8 px-6 py-3 bg-[var(--color-panel-2)] text-[var(--color-text)] border border-[var(--color-line)] rounded-lg hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-all"
			>
				$ cd ~/
			</a>
		</div>
	</div>
</BaseLayout>
