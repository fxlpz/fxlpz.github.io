---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Experiência & Certificações">
	<div class="space-y-16">
		<!-- Section Header -->
		<div class="space-y-3 reveal">
			<span class="page-eyebrow">// 03. HISTORY & CREDENTIALS</span>
			<h1 class="text-3xl sm:text-4xl font-mono font-bold text-[var(--color-text)]">
				&gt; Experiencia_&amp;_Formacao
			</h1>
			<div class="w-16 h-0.5 bg-[var(--color-accent)]"></div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
			<!-- Professional History Left -->
			<div class="lg:col-span-8 space-y-10 border-l border-[var(--color-line)] pl-6 relative">
				<!-- Mitutoyo -->
				<div class="relative reveal">
					<div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-[var(--color-bg)] border-2 border-[var(--color-accent)]"></div>
					<div class="space-y-2">
						<div class="flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
							<span class="text-[var(--color-accent)] font-semibold">Mitutoyo Sul Americana</span>
							<span class="text-[var(--color-text-mute)]">mar/2025 – mar/2026</span>
						</div>
						<h3 class="text-lg font-bold text-white font-mono m-0">Estagiário de Suporte de Informática</h3>
						<p class="text-sm text-[var(--color-text-dim)] leading-relaxed">
							Suporte completo N1/N2 para mais de 50 usuários em ambientes Microsoft e Linux. Desenvolvi documentações técnicas de procedimentos que geraram uma redução direta de 63% no TMA (Tempo Médio de Atendimento). Responsável pela auditoria interna e gestão de ativos de informática, bem como migrações e atualizações de infraestrutura.
						</p>
					</div>
				</div>

				<!-- FUMAS -->
				<div class="relative reveal">
					<div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-[var(--color-bg)] border-2 border-[var(--color-accent)]"></div>
					<div class="space-y-2">
						<div class="flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
							<span class="text-[var(--color-accent)] font-semibold">FUMAS</span>
							<span class="text-[var(--color-text-mute)]">fev/2024 – mar/2025</span>
						</div>
						<h3 class="text-lg font-bold text-white font-mono m-0">Estagiário de Suporte</h3>
						<p class="text-sm text-[var(--color-text-dim)] leading-relaxed">
							Suporte de sistemas para equipes internas de atendimento. Configuração e troubleshooting em redes locais TCP/IP, switches, ambientes operacionais Windows Client e ferramentas de produtividade.
						</p>
					</div>
				</div>

				<!-- SAM -->
				<div class="relative reveal">
					<div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-[var(--color-bg)] border-2 border-[var(--color-accent)]"></div>
					<div class="space-y-2">
						<div class="flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
							<span class="text-[var(--color-accent)] font-semibold">SAM (Sistema de Atendimento Médico)</span>
							<span class="text-[var(--color-text-mute)]">jan/2023 – jan/2024</span>
						</div>
						<h3 class="text-lg font-bold text-white font-mono m-0">Dev Full Stack</h3>
						<p class="text-sm text-[var(--color-text-dim)] leading-relaxed">
							Desenvolvimento de APIs REST robustas em Java/Spring Boot e interfaces modernas em React. Foco contínuo em validação estrita de entrada, sanitização e mitigação de vulnerabilidades lógicas. Implementei automação em Python que reduziu em 40% o tempo gasto com processos operacionais manuais. Administração de servidores locais Linux e Windows Server.
						</p>
					</div>
				</div>
			</div>

			<!-- Education & Certifications Right -->
			<div class="lg:col-span-4 space-y-8 font-mono text-xs reveal">
				<!-- Academico -->
				<div class="space-y-4">
					<h3 class="font-bold text-sm text-white border-b border-[var(--color-line)] pb-2 flex items-center gap-2 m-0">
						<span class="text-[var(--color-accent)]">&gt;</span> Formação Acadêmica
					</h3>
					<div class="p-4 rounded-lg bg-[var(--color-panel)] border border-[var(--color-line)] space-y-1">
						<div class="text-[var(--color-text-mute)]">PUC Minas (jul/2026)</div>
						<h4 class="font-bold text-white text-sm m-0">Tecnólogo em Segurança da Informação</h4>
						<p class="text-[var(--color-text-dim)] text-[10px] mt-1 leading-relaxed">Foco em defesa cibernética, análise de malware, conformidade (LGPD) e testes de invasão.</p>
					</div>
				</div>

				<!-- Certs -->
				<div class="space-y-4">
					<h3 class="font-bold text-sm text-white border-b border-[var(--color-line)] pb-2 flex items-center gap-2 m-0">
						<span class="text-[var(--color-accent)]">&gt;</span> Certificações
					</h3>

					<div class="space-y-2.5">
						<!-- DCPT in progress -->
						<div class="p-4 rounded bg-[var(--color-panel-2)] border border-[var(--color-accent)]/20 relative overflow-hidden">
							<div class="absolute right-0 top-0 bg-[var(--color-accent)] text-[var(--color-bg)] text-[9px] font-bold px-2 py-0.5 uppercase tracking-wider">DCPT</div>
							<div class="text-[var(--color-accent)] uppercase font-bold tracking-wider text-[9px] mb-1">Em Andamento</div>
							<h4 class="font-bold text-white text-sm m-0 leading-tight">DCPT - Desec Certified Penetration Tester</h4>
						</div>

						<ul class="space-y-2 text-[11px] text-[var(--color-text-dim)] list-none p-0 m-0">
							<li class="flex justify-between items-center bg-[var(--color-panel)] p-3 border border-[var(--color-line)] rounded">
								<span>Pentest na Prática (Desec Security)</span>
								<span class="text-[var(--color-accent)]">Concluído</span>
							</li>
							<li class="flex justify-between items-center bg-[var(--color-panel)] p-3 border border-[var(--color-line)] rounded">
								<span>Segurança em Linux (IBSEC 2025)</span>
								<span class="text-[var(--color-text-mute)]">Concluído</span>
							</li>
							<li class="flex justify-between items-center bg-[var(--color-panel)] p-3 border border-[var(--color-line)] rounded">
								<span>Google Hacking OffSec (XPSec 2024)</span>
								<span class="text-[var(--color-text-mute)]">Concluído</span>
							</li>
							<li class="flex justify-between items-center bg-[var(--color-panel)] p-3 border border-[var(--color-line)] rounded">
								<span>Santander Cibersegurança Bootcamp</span>
								<span class="text-[var(--color-text-mute)]">Concluído</span>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
